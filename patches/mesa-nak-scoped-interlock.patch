--- a/src/nouveau/compiler/nak_nir.c
+++ b/src/nouveau/compiler/nak_nir.c
@@ -1587,0 +1588,10 @@
+   /* A single unconditional pair in straight-line outer control flow can
+    * acquire and retire the same ticket at the shader's explicit boundaries.
+    * Keep the original whole-invocation lowering for exits, demotes, loops
+    * containing markers, and other control flow we cannot prove converges.
+    */
+   nir_intrinsic_instr *begin = NULL, *end = NULL;
+   bool scoped = false;
+#ifdef __SWITCH__
+   scoped = impl->structured && nak->sm == 52;
+#endif
@@ -1590,0 +1601,7 @@
+         if (instr->type == nir_instr_type_call)
+            scoped = false;
+         if (instr->type == nir_instr_type_jump) {
+            const nir_jump_type jump = nir_instr_as_jump(instr)->type;
+            if (jump != nir_jump_break && jump != nir_jump_continue)
+               scoped = false;
+         }
@@ -1593 +1610,2 @@
-         nir_intrinsic_op op = nir_instr_as_intrinsic(instr)->intrinsic;
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+         nir_intrinsic_op op = intrin->intrinsic;
@@ -1595,3 +1613,14 @@
-      }
-   }
-
+         if (op == nir_intrinsic_terminate || op == nir_intrinsic_terminate_if ||
+             op == nir_intrinsic_demote_samples || op == nir_intrinsic_abort)
+            scoped = false;
+         if (op == nir_intrinsic_begin_invocation_interlock) {
+            scoped &= !begin && !end && block->cf_node.parent == &impl->cf_node;
+            begin = intrin;
+         } else if (op == nir_intrinsic_end_invocation_interlock) {
+            scoped &= begin && !end && block->cf_node.parent == &impl->cf_node;
+            end = intrin;
+         }
+      }
+   }
+
+   scoped &= begin && end && !has_demote;
@@ -1615 +1644,2 @@
-            nir_instr_remove(instr);
+            if (!scoped)
+               nir_instr_remove(instr);
@@ -1642 +1672,3 @@
-   /* Cover early returns and discard with one interlock per invocation. */
+   /* Keep ticket/address setup common to both paths, outside the wait. */
+   if (scoped)
+      b.cursor = nir_before_instr(&begin->instr);
@@ -1660,2 +1692,5 @@
-   b.cursor = final_demote ? nir_before_instr(&final_demote->instr)
-                           : nir_after_impl(impl);
+   if (scoped)
+      b.cursor = nir_before_instr(&end->instr);
+   else
+      b.cursor = final_demote ? nir_before_instr(&final_demote->instr)
+                              : nir_after_impl(impl);
@@ -1662,0 +1698,4 @@
+   if (scoped) {
+      nir_instr_remove(&begin->instr);
+      nir_instr_remove(&end->instr);
+   }
