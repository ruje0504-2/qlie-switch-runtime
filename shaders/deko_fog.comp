#version 430
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,std430) readonly buffer Source { uint source[]; };
layout(binding=1,std430) buffer Destination { uint destination[]; };
layout(r32ui,binding=0) uniform writeonly uimage2D presentImage;
#define DEKO_RASTER
#define DEKO_MOTION_KERNEL
#include "raster_types.glsl"
layout(binding=2,std430) readonly buffer Commands { Draw draws[]; };
layout(binding=3,std430) readonly buffer Tiles { uint tiles[]; };
layout(std140,binding=0) uniform Parameters { vec4 p0;vec4 p1;vec4 p2;vec4 p3;ivec4 rect;uvec4 meta;uvec4 colors; } frame;
#include "raster_pixels.glsl"

shared ivec4 taps[16];
shared vec2 weights[16];
shared float horizontal[17*16];

vec2 bitmapPosition(Draw p,ivec2 q){
 precise vec2 d=vec2(q)+.5-p.p1.xy;
 return vec2(divide(p.p0.w*d.x,p.p1.z),divide(p.p0.x*d.y,p.p1.z));
}

float horizontalTap(Draw p,int row,ivec2 cols,float fx){
 uint address=p.colors.z+uint(row)*p.meta.x;
 precise float value=float(source[address+uint(cols.x)]&255u);
 if(fx!=0.0)value=value*(1.0-fx)+float(source[address+uint(cols.y)]&255u)*fx;
 return value;
}

void overBitmap(Draw p,ivec2 q,inout uvec4 color){
 if(any(lessThan(q,p.rect.xy))||any(greaterThanEqual(q,p.rect.zw)))return;
 uvec4 s;
 if((p.meta.z&524288u)!=0u)s=pixel(p,q-ivec2(p.p1.xy));
 else{
  vec2 uv=bitmapPosition(p,q);
  if(any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(p.meta.xy))))return;
  s=samplePixel(p,uv);
 }
 s=tint(p,s);
 if(s.a!=0u)color=composite(0u,s,color);
}

void main(){
 uint header=gl_WorkGroupID.x*4u,packedOrigin=tiles[header];
 uint first=tiles[header+1u],count=tiles[header+2u];
 ivec2 origin=ivec2(packedOrigin&65535u,packedOrigin>>16);
 ivec2 q=origin+ivec2(gl_LocalInvocationID.xy);
 uint index=uint(q.y)*frame.meta.x+uint(q.x);
 Draw fog=draws[tiles[first]];
 uint x=gl_LocalInvocationID.x,y=gl_LocalInvocationID.y;
 if(y==0u){
  precise vec2 f=bitmapPosition(fog,origin+ivec2(int(x)))-.5;
  ivec2 i=ivec2(floor(f)),last=ivec2(fog.meta.xy)-1;
  ivec2 lo=clamp(i,ivec2(0),last),hi=clamp(i+1,ivec2(0),last);
  taps[x]=ivec4(lo.x,hi.x,lo.y,hi.y);
  weights[x]=f-vec2(i);
 }
 barrier();
 // The linear fog batch is limited to 17 source rows per tile. All lanes
 // reach both barriers without crossing a variable-trip loop or filter branch.
 int firstRow=taps[0].z,rows=taps[15].w-firstRow+1;
 ivec2 cols=taps[x].xy;
 float fx=weights[x].x;
 if(int(y)<rows)horizontal[y*16u+x]=horizontalTap(fog,firstRow+int(y),cols,fx);
 if(y==0u&&rows==17)horizontal[16u*16u+x]=horizontalTap(fog,firstRow+16,cols,fx);
 barrier();
 ivec2 lines=taps[y].zw-ivec2(firstRow);
 float fy=weights[y].y;
 precise float value=horizontal[lines.x*16+int(x)];
 if(fy!=0.0)value=value*(1.0-fy)+horizontal[lines.y*16+int(x)]*fy;
 uint gray=uint(floor(value+.5)),alpha=fog.meta.w;
 uvec4 b=unpack(destination[index+frame.meta.x*frame.meta.y]);
 uvec4 w=(uvec4(gray,gray,gray,alpha)*(alpha+(alpha>>7u)))>>8u;
 uvec4 color=min(uvec4(255),w+b-((w*b)>>8u));
 for(uint i=1u;i<count;++i)overBitmap(draws[tiles[first+i]],q,color);
 uint result=pack(color);
 destination[index]=result;
 if(frame.meta.z!=0u)imageStore(presentImage,q,uvec4(result,0,0,0));
}
