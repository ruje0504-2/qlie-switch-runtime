#version 430
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,std430) readonly buffer Source { uint source[]; };
layout(binding=1,std430) buffer Destination { uint destination[]; };
layout(r32ui,binding=0) uniform writeonly uimage2D presentImage;
#define DEKO_RASTER
#define DEKO_MOTION_KERNEL
#include "raster_types.glsl"
layout(binding=2,std430) readonly buffer Commands { Draw draws[]; };
layout(binding=3,std430) readonly buffer Tiles { uint tiles[]; };
layout(std140,binding=0) uniform Parameters { vec4 p0;vec4 p1;vec4 p2;vec4 p3;ivec4 rect;uvec4 meta;uvec4 colors; } frame;
#include "raster_pixels.glsl"

#include "raster_gray.glsl"

void overBitmap(Draw p,ivec2 q,inout uvec4 color){
 if(any(lessThan(q,p.rect.xy))||any(greaterThanEqual(q,p.rect.zw)))return;
 uvec4 s;
 if((p.meta.z&524288u)!=0u)s=pixel(p,q-ivec2(p.p1.xy));
 else{
  vec2 uv=bitmapPosition(p,q);
  if(any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(p.meta.xy))))return;
  s=samplePixel(p,uv);
 }
 s=tint(p,s);
 if(s.a!=0u)color=composite(0u,s,color);
}

void main(){
 uint header=gl_WorkGroupID.x*4u,packedOrigin=tiles[header];
 uint first=tiles[header+1u],count=tiles[header+2u];
 ivec2 origin=ivec2(packedOrigin&65535u,packedOrigin>>16);
 ivec2 q=origin+ivec2(gl_LocalInvocationID.xy);
 uint index=uint(q.y)*frame.meta.x+uint(q.x);
 Draw fog=draws[tiles[first]];
 uint gray=fogGray(fog,q),alpha=fog.meta.w;
 uvec4 b=unpack(destination[index+frame.meta.x*frame.meta.y]);
 uvec4 w=(uvec4(gray,gray,gray,alpha)*(alpha+(alpha>>7u)))>>8u;
 uvec4 color=min(uvec4(255),w+b-((w*b)>>8u));
 for(uint i=1u;i<count;++i)overBitmap(draws[tiles[first+i]],q,color);
 uint result=pack(color);
 destination[index]=result;
 if(frame.meta.z!=0u)imageStore(presentImage,q,uvec4(result,0,0,0));
}
