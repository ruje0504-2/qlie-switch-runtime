// uam lowers dynamic integer division through floating point. Correct the
// small color quotients explicitly; large dim numerators use integer division by shifts.
uint exactQuotient(uint n,uint d){
 if(n<d)return 0u;
 if(n<0x1000000u){
  uint q=uint(float(n)/float(d));
  uint product=q*d;
  if(product<=n&&n-product<d)return q;
 }
 uint q=0u;
 for(int bit=findMSB(n)-findMSB(d);bit>=0;--bit){
  uint part=d<<bit;
  if(n>=part){n-=part;q|=1u<<bit;}
 }
 return q;
}
uvec3 exactQuotient(uvec3 n,uint d){
 return uvec3(exactQuotient(n.x,d),exactQuotient(n.y,d),exactQuotient(n.z,d));
}
#define RASTER_DIV(n,d) exactQuotient(n,d)
