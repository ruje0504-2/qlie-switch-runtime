#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=1,std430) buffer Destination { uint destination[]; };
layout(set=0,binding=3,std430) readonly buffer Work { uint words[]; };
layout(push_constant) uniform Parameters { vec4 p0,p1,p2,p3;ivec4 rect;uvec4 meta,colors; } frame;
void main(){
 uint header=frame.colors.y+gl_WorkGroupID.x*4u;
 uint origin=words[header],control=words[header+3u];
 uvec2 q=uvec2(origin&65535u,origin>>16)+gl_LocalInvocationID.xy;
 uint index=q.y*1280u+q.x,cache=921600u+index;
 uint color=(control&0x80000000u)!=0u?destination[cache]:frame.colors.x;
 destination[index]=color;
 if((control&0x7fffffffu)!=0u)destination[cache]=color;
}
